#!/usr/bin/env bash
set -euo pipefail
while IFS= read -r -d '' file; do
    case "$file" in
        build/*|*.o|*.a|*.so|*.dylib|*.dll|*.exe|*.vala.c|*.moc|qrc_*.cpp)
            printf 'Generated artifact must not be committed: %s\n' "$file" >&2; exit 1 ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)
